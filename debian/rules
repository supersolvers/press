#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

%:
	dh $@

override_dh_auto_build:
	cargo build --locked --release
	$(MAKE) styles PROFILE=release

override_dh_auto_test:
	cargo test --locked --workspace
	cargo run --locked -p press-idl -- --check

override_dh_auto_install:
	$(MAKE) install PROFILE=release PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) \
		DESTDIR=$(CURDIR)/debian/tmp INSTALL_FONTS=no
